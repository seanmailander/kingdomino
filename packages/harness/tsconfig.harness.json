{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist-harness",
    "rootDir": "./",
    "lib": ["ES2022"],
    "incremental": true,
    "tsBuildInfoFile": "./dist-harness/.tsbuildinfo"
  },
  "include": [
    "./**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "dist-harness",
    "**/*.test.ts"
  ]
}
